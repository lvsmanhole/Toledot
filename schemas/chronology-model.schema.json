{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "record_type", "records"],
  "properties": {
    "schema_version": {"const": 1},
    "record_type": {"const": "chronology_models"},
    "records": {"type": "array", "items": {"type": "object", "required": ["id", "name", "description", "derivations", "resolutions", "citations"], "properties": {"id": {"type": "string"}, "name": {"type": "string"}, "description": {"type": "string"}, "derivations": {"type": "array", "items": {"type": "object", "required": ["id", "operation"], "properties": {"id": {"type": "string"}, "operation": {"enum": ["literal", "offset_years", "midpoint", "select_claim"]}, "year": {"type": "object"}, "input_id": {"type": "string"}, "input_ids": {"type": "array", "items": {"type": "string"}}, "offset_years": {"type": "integer"}, "claim_id": {"type": "string"}, "offset_claim_id": {"type": "string"}}, "additionalProperties": true}}, "resolutions": {"type": "array", "items": {"type": "object", "required": ["entity_id", "birth_derivation_id", "death_derivation_id", "life_basis", "confidence_grade", "evidence_claim_ids", "explanation"], "properties": {"entity_id": {"type": "string"}, "birth_derivation_id": {"type": "string"}, "death_derivation_id": {"type": "string"}, "life_basis": {"enum": ["explicit", "calculated", "synchronized", "historically_inferred", "editorial_estimate"]}, "confidence_grade": {"enum": ["A", "B", "C", "D", "E"]}, "evidence_claim_ids": {"type": "array", "items": {"type": "string"}}, "alternative_claim_ids": {"type": "array", "items": {"type": "string"}}, "explanation": {"type": "string"}}, "additionalProperties": true}}, "citations": {"$ref": "common.schema.json#/$defs/citationList"}}, "additionalProperties": true}}
  },
  "additionalProperties": false
}
