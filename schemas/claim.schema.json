{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "record_type", "records"],
  "properties": {
    "schema_version": {"const": 1},
    "record_type": {"const": "claims"},
    "records": {"type": "array", "items": {"type": "object", "required": ["id", "subject_id", "predicate", "value", "evidence_type", "confidence", "citations"], "properties": {"id": {"$ref": "common.schema.json#/$defs/stableId"}, "subject_id": {"$ref": "common.schema.json#/$defs/stableId"}, "predicate": {"type": "string"}, "object_id": {"$ref": "common.schema.json#/$defs/stableId"}, "value": {"type": "object"}, "evidence_type": {"type": "string"}, "witness_id": {"$ref": "common.schema.json#/$defs/stableId"}, "confidence": {"enum": ["A", "B", "C", "D", "E"]}, "interpretation_note": {"type": "string"}, "citations": {"$ref": "common.schema.json#/$defs/citationList"}}, "allOf": [{"if": {"properties": {"value": {"properties": {"kind": {"const": "historical_year"}}, "required": ["kind"]}}, "required": ["value"]}, "then": {"properties": {"value": {"required": ["era", "year"], "properties": {"era": {"enum": ["BCE", "CE"]}, "year": {"type": "integer", "minimum": 1}}}}}}], "additionalProperties": true}}
  },
  "additionalProperties": false
}
