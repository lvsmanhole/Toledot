# Cloudflare Pages response headers (copied into site/ by the journey build).

# Vite's chunks carry a content hash in their names: cache them for good.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Skies, textures and models change only when the asset manifest does.
/lib/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
  Access-Control-Allow-Origin: *

/lib/hdri/*.hdr
  Content-Type: application/octet-stream

# The data bundle and pages are revalidated on each visit so a deploy shows at once.
/data/*
  Cache-Control: public, max-age=0, must-revalidate

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
